---
import { Image } from 'astro:assets';
import logo from '@images/gumiho/transparent gumihollc logo.png';
import { SITE } from '@data/constants';

/**
 * Earnest Gumiho mark plus wordmark. The round logo's own "Earnest Gumiho"
 * lettering is illegible at navbar size, so the name is also set as text.
 * `class` sizes the whole lockup; `hideText` shows the mark alone.
 */
interface Props {
  class?: string;
  hideText?: boolean;
}

const { class: className, hideText = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-x-2', className]}>
  <Image
    src={logo}
    alt=""
    width={96}
    height={96}
    class="h-10 w-10 shrink-0 rounded-full"
    loading="eager"
  />
  {!hideText && (
    <span class="text-lg leading-tight font-bold whitespace-nowrap text-neutral-800 dark:text-neutral-200">
      {SITE.title}
    </span>
  )}
</span>
