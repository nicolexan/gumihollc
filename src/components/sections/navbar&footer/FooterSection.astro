---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import { CONTACT, SITE } from '@data/constants';
import { footerSections, socialLinks } from '@data/navigation';
import { localePath } from '@utils/locale';

const { locale, copy: t } = Astro.locals;
const footer = t.nav.footer;

const socialIconClass =
  'h-4 w-4 shrink-0 text-neutral-700 dark:text-neutral-400';
const contactLinkClass =
  'inline-flex items-center gap-x-2 rounded-lg text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-pink-500 focus-visible:ring-3 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-pink-300 dark:focus:outline-hidden';
const contactIconClass = 'h-4 w-4 shrink-0';
---

<footer class="w-full bg-neutral-100 dark:bg-neutral-900">
  <div class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)">
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-full lg:col-span-1">
        {/* Brand Logo */}
        <BrandLogo />
        <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">
          {footer.tagline}
        </p>
      </div>
      {/* Link sections from the copy table (Shop, Company, …) */}
      {footerSections.map(section => (
        <div class="col-span-1">
          <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
            {footer.sectionTitles[section.id]}
          </h3>
          <ul class="mt-3 grid space-y-3">
            {section.links.map(link => (
              <li>
                <a
                  href={localePath(locale, link.path)}
                  class="inline-flex gap-x-2 rounded-lg text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-300 dark:focus:outline-hidden"
                >
                  {footer.links[link.id]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="col-span-2">
        <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
          {footer.getInTouch}
        </h3>
        <ul class="mt-3 grid space-y-3 text-sm">
          <li>
            <a class={contactLinkClass} href={`mailto:${CONTACT.email}`}>
              <Icon name="envelopeOpen" class={contactIconClass} />
              {CONTACT.email}
            </a>
          </li>
          <li class="inline-flex items-center gap-x-2 text-neutral-600 dark:text-neutral-400">
            <Icon name="chatBubble" class={contactIconClass} />
            {footer.kakaoTalk}: {CONTACT.kakaoTalkId}
          </li>
          <li>
            <a
              class={contactLinkClass}
              href={CONTACT.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="instagram" class={contactIconClass} />
              {`@${CONTACT.instagramHandle}`}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
      <div class="flex items-center justify-between">
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          © <span id="current-year"></span>
          {` `}
          {SITE.company}. {footer.rightsReserved}
        </p>
      </div>

      {/* Social Brands */}
      <div>
        <FooterSocialLink url={socialLinks.instagram} label="Instagram">
          <Icon name="instagram" class={socialIconClass} title="Instagram" />
        </FooterSocialLink>
      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById('current-year');
      element!.innerText = year.toString();
    </script>
  </div>
</footer>
