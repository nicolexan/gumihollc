---
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { CONTACT } from '@data/constants';
import { localePath } from '@utils/locale';

/**
 * Company contact details. No form: Gumiho LLC prefers customers reach out
 * directly by email.
 */
const { locale, copy: t } = Astro.locals;
const copy = t.contact;
const blockIconClass =
  'mt-1.5 h-6 w-6 shrink-0 text-pink-500 dark:text-pink-300';
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1 class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
        {copy.heading}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid gap-x-16 divide-y divide-neutral-300 sm:grid-cols-2 sm:divide-y-0 dark:divide-neutral-700">
      <ContactIconBlock
        heading={copy.emailHeading}
        content={copy.emailContent}
        isLinkVisible={true}
        linkTitle={CONTACT.email}
        linkURL={`mailto:${CONTACT.email}`}
      >
        <Icon name="envelopeOpen" class={blockIconClass} />
      </ContactIconBlock>

      <ContactIconBlock
        heading={copy.faqHeading}
        content={copy.faqContent}
        isLinkVisible={true}
        linkTitle={copy.faqLink}
        linkURL={localePath(locale, '/faq')}
        isArrowVisible={true}
      >
        <Icon name="question" class={blockIconClass} />
      </ContactIconBlock>
    </div>
  </div>
</section>
