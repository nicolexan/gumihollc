---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@components/ui/icons/Icon.astro';

const { title, btnId, btnTitle, url, bgImage } = Astro.props;
const { copy: t } = Astro.locals;

interface Props {
  title?: string;
  btnId: string;
  btnTitle: string;
  url: string;
  /** Optional photo behind the banner; resized to the banner's width. */
  bgImage?: ImageMetadata;
}

const storageKey = `banner-dismissed:${btnId}`;

// The banner is at most `max-w-4xl` (896px) wide; 2x for high-DPI screens.
const bg = bgImage
  ? await getImage({ src: bgImage, width: 1792, format: 'webp' })
  : undefined;
const bgStyle = bg
  ? `background-image: linear-gradient(rgb(0 0 0 / 0.45), rgb(0 0 0 / 0.45)), url('${bg.src}')`
  : undefined;
---

<astro-banner btnId={btnId} storageKey={storageKey} class="hidden">
  <div
    class="fixed start-1/2 bottom-0 z-50 mx-auto w-full -translate-x-1/2 transform p-6 sm:max-w-4xl"
    role="region"
    aria-label={t.banner.region}
  >
    <div
      class:list={[
        'rounded-xl bg-cover bg-center bg-no-repeat p-4 text-center shadow-xs',
        bg
          ? 'bg-neutral-800'
          : "bg-neutral-800 bg-[url('/banner-pattern.svg')] dark:bg-neutral-200",
      ]}
      style={bgStyle}
    >
      <div class="flex items-center justify-center">
        <div class="ml-auto">
          {title && (
            <p
              class:list={[
                'me-2 inline-block font-medium text-neutral-50',
                !bg && 'dark:text-neutral-700',
              ]}
            >
              {title}
            </p>
          )}
          <a
            class:list={[
              'group inline-flex items-center gap-x-2 rounded-full border-2 border-neutral-50 px-3 py-2 text-sm font-semibold text-neutral-50 transition duration-300 hover:border-neutral-100/70 hover:text-neutral-50/70 disabled:pointer-events-none disabled:opacity-50 dark:focus:outline-hidden',
              bg
                ? 'bg-neutral-900/30 backdrop-blur-xs'
                : 'backdrop-brightness-75 sm:backdrop-brightness-100 dark:border-neutral-700 dark:text-neutral-700 dark:backdrop-brightness-100 dark:hover:border-neutral-700/70 dark:hover:text-neutral-800/70',
            ]}
            href={url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {btnTitle}
            <Icon
              name="arrowRight"
              class="size-4 shrink-0 transition duration-300 group-hover:translate-x-1"
            />
          </a>
        </div>
        <button
          type="button"
          class="ml-auto inline-flex items-center gap-x-2 rounded-full border border-transparent bg-gray-100 p-2 text-sm font-semibold text-gray-800 hover:bg-gray-200 disabled:pointer-events-none disabled:opacity-50 dark:bg-neutral-700 dark:text-neutral-50 dark:hover:bg-neutral-700/80 dark:hover:text-neutral-50 dark:focus:outline-hidden"
          id={btnId}
        >
          <span class="sr-only">{t.banner.dismiss}</span>
          <Icon name="close" class="size-5 shrink-0" />
        </button>
      </div>
    </div>
  </div>
</astro-banner>
<script>
  class AstroBanner extends HTMLElement {
    connectedCallback() {
      const btnId = this.getAttribute('btnId');
      const storageKey = this.getAttribute('storageKey');
      if (storageKey && localStorage.getItem(storageKey) === '1') {
        this.remove();
        return;
      }
      this.classList.remove('hidden');
      const button = btnId ? this.querySelector(`#${btnId}`) : null;
      if (button != null) {
        button.addEventListener('click', () => {
          if (storageKey) localStorage.setItem(storageKey, '1');
          this.remove();
        });
      }
    }
  }

  customElements.define('astro-banner', AstroBanner);
</script>
