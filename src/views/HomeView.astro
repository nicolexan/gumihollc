---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/gumiho/Ginseng_Latte.png';
import featureImage from '@images/gumiho/geumsan korea banner image.jpg';
import geumsanImage from '@images/gumiho/geumsan korea ginseng capital.jpg';
import farmersImage from '@images/gumiho/ginseng from farmers.webp';
import spoonImage from '@images/gumiho/white background spoon of ginseng.jpg';
import bannerImage from '@images/gumiho/geumsan korea mountains.jpg';
import { SHOP } from '@data/constants';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/** The home page in one locale. Copy comes from the locale's copy table. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;
---

<MainLayout>
  <AnnouncementBanner
    btnId="amazon-banner-dismiss"
    title={copy.banner.title}
    btnTitle={copy.banner.btn}
    url={SHOP.amazonUrl}
    bgImage={bannerImage}
  />

  <HeroSection
    title={copy.hero.title}
    subTitle={copy.hero.subTitle}
    primaryBtn={copy.hero.primaryBtn}
    primaryBtnURL={localePath(locale, '/products')}
    secondaryBtn={copy.hero.secondaryBtn}
    secondaryBtnURL={localePath(locale, '/blog')}
    src={heroImage}
    alt={copy.hero.imageAlt}
    imagePosition="50% 75%"
  />

  <FeaturesGeneral
    title={copy.featuresGeneral.title}
    subTitle={copy.featuresGeneral.subTitle}
    src={featureImage}
    alt={copy.featuresGeneral.imageAlt}
    features={t.data.features}
  />

  <FeaturesNavs
    title={copy.featuresNavs.title}
    tabs={[
      {
        ...copy.featuresNavs.tabs.origin,
        svg: 'mapPin',
        src: geumsanImage,
        first: true,
      },
      {
        ...copy.featuresNavs.tabs.harvest,
        svg: 'sparks',
        src: farmersImage,
        second: true,
      },
      {
        ...copy.featuresNavs.tabs.purity,
        svg: 'verified',
        src: spoonImage,
      },
    ]}
  />

  <TestimonialsSection
    title={copy.testimonials.title}
    subTitle={copy.testimonials.subTitle}
    testimonials={copy.testimonials.quotes}
    statistics={copy.testimonials.statistics}
  />

  <FAQ title={copy.faqTitle} faqs={t.data.faqs} />
</MainLayout>
