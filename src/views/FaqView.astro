---
import MainLayout from '@/layouts/MainLayout.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/** The FAQ page in one locale. Questions come from the locale's `faqs.json`. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.faq;
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
  <FAQ title={copy.heading} faqs={t.data.faqs} />
</MainLayout>
